# ==============================================================================
# KROVEX — PRODUCTION & ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' and fill in your values.
# NEVER commit your actual '.env' file or share tokens/secrets!
# ==============================================================================

# ------------------------------------------------------------------------------
# DISCORD BOT CREDENTIALS (REQUIRED)
# ------------------------------------------------------------------------------
# Your Discord bot token from the Discord Developer Portal:
# https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Your Discord application / client ID
DISCORD_CLIENT_ID=1570428426974662718

# Optional: Dedicated development guild ID for instantaneous slash command sync
DEV_GUILD_ID=1560990395666538529

# Discord user IDs of bot developers/owners (comma-separated integers)
OWNER_IDS=your_discord_user_id_here

# ------------------------------------------------------------------------------
# SPOTIFY WEB API CREDENTIALS (RECOMMENDED FOR HIGH-FIDELITY MUSIC)
# ------------------------------------------------------------------------------
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ------------------------------------------------------------------------------
# KROVEX SOUL & AI NATURAL LANGUAGE ASSISTANT (GEMINI)
# ------------------------------------------------------------------------------
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
SOUL_ENABLED=true
SOUL_MODEL=gemini-2.5-flash
SOUL_TIMEOUT=12.0
SOUL_MAX_TURNS=10
SOUL_COOLDOWN_SECONDS=3.0

# ------------------------------------------------------------------------------
# DASHBOARD & WEB SERVER CONFIGURATION
# ------------------------------------------------------------------------------
DASHBOARD_ENABLED=true
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DASHBOARD_REDIRECT_URI=https://krovex.bot/api/auth/callback
SESSION_SECRET_KEY=generate_a_random_32_character_secret_key_here

# ------------------------------------------------------------------------------
# BRANDING & CANONICAL LINKS
# ------------------------------------------------------------------------------
SUPPORT_SERVER_URL=https://discord.gg/89tXm2ZEqR
WEBSITE_URL=https://krovex.bot

# ------------------------------------------------------------------------------
# BOT BEHAVIOR & ENVIRONMENT
# ------------------------------------------------------------------------------
DEFAULT_PREFIX=!
ENVIRONMENT=production
LOG_LEVEL=INFO
# Automatic slash command sync on startup (defaults to true; set to false on Render to prevent 200/day rate limits)
SYNC_COMMANDS_ON_STARTUP=true

# Visual Identity - Hex color codes for Discord embeds (Neon Purple theme)
COLOR_PRIMARY=0x9D4EDD
COLOR_SUCCESS=0x00F5A0
COLOR_ERROR=0xFF3366
COLOR_WARNING=0xF59E0B
COLOR_INFO=0x7B2CBF

# ------------------------------------------------------------------------------
# MUSIC SYSTEM CONFIGURATION
# ------------------------------------------------------------------------------
LAVALINK_ENABLED=false
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
MAX_QUEUE_SIZE=500
DEFAULT_VOLUME=100

# ------------------------------------------------------------------------------
# VOICE & WELCOME
# ------------------------------------------------------------------------------
VOICE_STATUS_UPDATE_INTERVAL=60
INVITE_TRACKING_ENABLED=true
